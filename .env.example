# ---- Database ----
POSTGRES_USER=suas
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=suas

# ---- Backend ----
# Demo mode: fixed fixture weather instead of the live provider, so every plan
# is advisory and nothing reaches the network for weather. Never for real flights.
DEMO_MODE=false

# Language model. Leave OPENAI_API_KEY blank to run with deterministic report text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API-key gate for /api/plan. Leave blank to disable auth (local only).
# Compose passes this to the backend as SUAS_API_KEY and to the frontend as
# BACKEND_API_KEY, where only the server-side proxy reads it.
API_KEY=

# Optional per-operator keys for the backend, id:key,id:key (#81). Each mission
# is visible only to the key that planned it; API_KEY above is operator 'default'.
API_KEYS=

# Per-browser operators for the dashboard (#82). The frontend proxy gives each
# browser its own session cookie and signs it with this secret, so a browser
# sees only its own missions; clearing cookies loses that browser's threads.
# Blank here means Compose uses its PUBLIC demo-only secret, which anyone can
# forge with: set 32+ random characters (openssl rand -hex 32) before sharing
# the stack with anyone. It never reaches the browser.
SESSION_KEY_SECRET=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Emit machine-parseable JSON logs. Set false for readable local output.
JSON_LOGS=true

# Battery reserve withheld from usable capacity, as a percent.
BATTERY_RESERVE_PERCENT=20

# Age at which graph checkpoints are purged, in days. 0 disables retention.
CHECKPOINT_RETENTION_DAYS=30

# Per-client rate limit on /api/plan. In-process, per worker.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_S=60

# ---- Frontend ----
# Backend URL as reachable from the Next.js server process (not the browser).
BACKEND_API_URL=http://backend:8000

# Server-side only. Read by the Next.js route handlers that proxy to the
# backend. Deliberately NOT prefixed NEXT_PUBLIC_, so Next.js will not inline
# them into the client bundle and the browser never sees them.

# Backend base URL, reachable from the Next.js server process. No trailing slash.
BACKEND_API_URL=http://localhost:8000

# Sent upstream as X-API-Key. Leave blank when the backend has auth off.
BACKEND_API_KEY=
